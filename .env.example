# Copy this file to ".env" (same folder) and paste your key below. ".env" is git-ignored.
# Server-side only: the key is never sent to the browser. Restart `npm run dev` after editing.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: any model id from https://openrouter.ai/models (default: deepseek/deepseek-v4-flash)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional: your public site URL, sent to OpenRouter as the referer (default: http://localhost:8080)
SITE_URL=
